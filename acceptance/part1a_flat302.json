{
  "name": "SplitKaro acceptance scenario: flat-302 monthly expenses",
  "purpose": "New, realistic data not used by the spec tests. Expected values were computed by hand from the spec rules (integer paise, floor + alphabetical remainder, greedy settle).",
  "hand_calculation": {
    "rent 32000.00 percent 30/25/25/20": "aditi 9600.00, kabir 8000.00, nisha 8000.00, om 6400.00",
    "groceries 1234.57 equal /4": "123457 paise / 4 = 30864 r1 -> aditi 308.65 (alphabetically first), kabir/nisha/om 308.64",
    "wifi 999.00 exact": "aditi 250, kabir 250, nisha 250, om 249",
    "dinner 850.01 equal among kabir,nisha": "85001 / 2 = 42500 r1 -> kabir 425.01, nisha 425.00",
    "aditi": "paid 32000.00 - owes (9600 + 308.65 + 250) = +21841.35",
    "kabir": "paid 1234.57 - owes (8000 + 308.64 + 250 + 425.01) = -7749.08",
    "nisha": "paid 850.01 - owes (8000 + 308.64 + 250 + 425.00) = -8133.63",
    "om": "paid 999.00 - owes (6400 + 308.64 + 249) = -5958.64",
    "check": "21841.35 - 7749.08 - 8133.63 - 5958.64 = 0.00",
    "settle (largest debtor first)": "nisha -> aditi 8133.63, kabir -> aditi 7749.08, om -> aditi 5958.64"
  },
  "steps": [
    {"id": "A01", "what": "create group (members given unsorted)", "args": ["group", "create", "flat-302", "--members", "om,nisha,kabir,aditi"],
     "exit": 0, "stdout": "Created group flat-302 with 4 members: aditi, kabir, nisha, om", "traces": ["AC-001"]},
    {"id": "A02", "what": "rent by percentage", "args": ["expense", "add", "flat-302", "--paid-by", "aditi", "--amount", "32000", "--desc", "Rent November", "--split", "percent", "--shares", "aditi=30,kabir=25,nisha=25,om=20"],
     "exit": 0, "stdout": "Added expense 1 (32000.00) to flat-302", "traces": ["AC-016"]},
    {"id": "A03", "what": "groceries equal with a leftover paisa", "args": ["expense", "add", "flat-302", "--paid-by", "kabir", "--amount", "1234.57", "--desc", "BigBasket groceries"],
     "exit": 0, "stdout": "Added expense 2 (1234.57) to flat-302", "traces": ["AC-007", "AC-008"]},
    {"id": "A04", "what": "wifi exact shares", "args": ["expense", "add", "flat-302", "--paid-by", "om", "--amount", "999", "--desc", "Airtel fibre", "--split", "exact", "--shares", "aditi=250,kabir=250,nisha=250,om=249"],
     "exit": 0, "stdout": "Added expense 3 (999.00) to flat-302", "traces": ["AC-014"]},
    {"id": "A05", "what": "dinner for two only", "args": ["expense", "add", "flat-302", "--paid-by", "nisha", "--amount", "850.01", "--desc", "Dinner", "--among", "kabir,nisha"],
     "exit": 0, "stdout": "Added expense 4 (850.01) to flat-302", "traces": ["AC-009", "AC-008"]},
    {"id": "A06", "what": "shares of expense 2 and 4 (remainder rule)", "args": ["expense", "list", "flat-302", "--json"],
     "exit": 0, "json_check": {"2": {"aditi": 30865, "kabir": 30864, "nisha": 30864, "om": 30864}, "4": {"kabir": 42501, "nisha": 42500}}, "traces": ["AC-008", "AC-033"]},
    {"id": "A07", "what": "balances", "args": ["balances", "flat-302"],
     "exit": 0, "stdout": "aditi  +21841.35\nkabir  -7749.08\nnisha  -8133.63\nom     -5958.64", "traces": ["AC-020", "AC-021"]},
    {"id": "A08", "what": "settle plan", "args": ["settle", "flat-302"],
     "exit": 0, "stdout": "nisha -> aditi 8133.63\nkabir -> aditi 7749.08\nom -> aditi 5958.64", "traces": ["AC-024", "AC-027"]},
    {"id": "A09", "what": "overpayment rejected", "args": ["pay", "flat-302", "--from", "om", "--to", "aditi", "--amount", "6000"],
     "exit": 4, "stderr_contains": "payment exceeds outstanding balance", "traces": ["AC-032"]},
    {"id": "A10", "what": "exact repayment accepted", "args": ["pay", "flat-302", "--from", "om", "--to", "aditi", "--amount", "5958.64"],
     "exit": 0, "stdout": "Recorded payment om -> aditi 5958.64", "traces": ["AC-030"]},
    {"id": "A11", "what": "settle after payment", "args": ["settle", "flat-302"],
     "exit": 0, "stdout": "nisha -> aditi 8133.63\nkabir -> aditi 7749.08", "traces": ["AC-030", "AC-024"]},
    {"id": "A12", "what": "delete blocked after a settlement", "args": ["expense", "delete", "flat-302", "1"],
     "exit": 4, "stderr_contains": "cannot delete expense after settlements", "traces": ["AC-035"]},
    {"id": "A13", "what": "3 decimal places rejected", "args": ["expense", "add", "flat-302", "--paid-by", "om", "--amount", "12.345", "--desc", "Milk"],
     "exit": 1, "stderr_contains": "invalid amount", "traces": ["AC-010"]},
    {"id": "A14", "what": "unknown member", "args": ["expense", "add", "flat-302", "--paid-by", "zara", "--amount", "100", "--desc", "Milk"],
     "exit": 3, "stderr_contains": "member zara not found in group flat-302", "traces": ["AC-011"]},
    {"id": "A15", "what": "percentages summing to 99", "args": ["expense", "add", "flat-302", "--paid-by", "om", "--amount", "100", "--desc", "Gas", "--split", "percent", "--shares", "aditi=33,kabir=33,nisha=33"],
     "exit": 1, "stderr_contains": "percentages must sum to 100", "traces": ["AC-017"]},
    {"id": "A16", "what": "corrupt data file is refused and left untouched", "corrupt_file": "{\"version\": 1, \"groups\": {\"x\": 42}}", "args": ["group", "list"],
     "exit": 5, "stderr_contains": "data file is corrupt", "traces": ["AC-038"]}
  ]
}
