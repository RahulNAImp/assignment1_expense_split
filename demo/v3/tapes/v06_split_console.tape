# generated by demo/v3/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v3/build/v06_split_console.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Hide
Type "cd Part-1A && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore SPLITKARO_DATA=/tmp/v3-demo.json && rm -f /tmp/v3-demo.json && clear" Enter
Sleep 1s
Show
Sleep 1.2s
Type@1ms "splitkaro group create trip --members mike,josh,kimberly"
Sleep 500ms
Enter
Sleep 500ms
Type@1ms "splitkaro expense add trip --paid-by mike --amount 900 --desc Dinner"
Sleep 500ms
Enter
Sleep 500ms
Type@1ms "splitkaro expense add trip --paid-by josh --amount 100 --desc Snacks"
Sleep 500ms
Enter
Sleep 1.2s
Hide
Type "clear" Enter
Sleep 200ms
Show
Type@1ms "splitkaro expense list trip --json | grep -A4 shares_paise"
Sleep 500ms
Enter
Sleep 3.4s
Hide
Type "clear" Enter
Sleep 200ms
Show
Type@1ms "splitkaro balances trip"
Sleep 500ms
Enter
Sleep 1.2s
Type@1ms "splitkaro settle trip"
Sleep 500ms
Enter
Sleep 6s
