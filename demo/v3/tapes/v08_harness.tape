# generated by demo/v3/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v3/build/v08_harness.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Hide
Type "cd Part-1A && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore && clear" Enter
Sleep 1s
Show
Sleep 300ms
Type@1ms "python .harness/run_harness.py --label 'demo video v3'"
Sleep 500ms
Enter
Sleep 200ms
Wait+Screen@60s /OVERALL/
Sleep 7s
