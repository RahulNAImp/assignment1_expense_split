# generated by demo/v3/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v3/build/v07_split_code.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Hide
Type "cd Part-1A && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore && clear" Enter
Sleep 1s
Show
Sleep 500ms
Type@1ms "sed -n '/^def _distribute_remainder/,/^def allocate_percent/p' src/splitkaro/money.py"
Sleep 500ms
Enter
Sleep 6.5s
Hide
Type "clear" Enter
Sleep 200ms
Show
Type@1ms "python -m pytest -v -p no:cacheprovider -k 'ac008 or ac020 or remainder' tests"
Sleep 500ms
Enter
Sleep 200ms
Wait+Screen@60s /passed/
Sleep 5s
