# generated by demo/v2/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v2/build/s08_1b_harness.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set TypingSpeed 65ms
Hide
Type "cd Part-1B && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore && clear" Enter
Sleep 1s
Show
Type@1ms "# Final evaluation: 25 cases, 3 layers, thresholds fixed in the spec"
Sleep 900ms
Enter
Sleep 300ms
Type "python ../demo/show_eval.py run-006 --brief"
Sleep 450ms
Enter
Sleep 22s
