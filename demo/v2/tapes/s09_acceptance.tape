# generated by demo/v2/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v2/build/s09_acceptance.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set TypingSpeed 65ms
Hide
Type "cd Part-1B && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore && clear" Enter
Sleep 1s
Show
Type "# Acceptance test on NEW data (never seen by any test)"
Sleep 450ms
Enter
Sleep 300ms
Type@1ms "sed -n '/^## Summary/,/^## Part 1A/p' ../acceptance/RESULTS.md | head -8"
Sleep 900ms
Enter
Sleep 16s
