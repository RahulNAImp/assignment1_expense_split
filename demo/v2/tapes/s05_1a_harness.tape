# generated by demo/v2/make_tapes.py - real commands recorded with charmbracelet/vhs
Output demo/v2/build/s05_1a_harness.mp4
Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set TypingSpeed 65ms
Hide
Type "cd Part-1A && source .venv/bin/activate && export PYTHONPATH=src PS1='$ ' PYTHONWARNINGS=ignore && clear" Enter
Sleep 1s
Show
Type "# One command, six independent gates"
Sleep 450ms
Enter
Sleep 300ms
Type "python .harness/run_harness.py --label 'demo video v2'"
Sleep 450ms
Enter
Sleep 1s
Wait+Screen@120s /OVERALL/
Sleep 16s
